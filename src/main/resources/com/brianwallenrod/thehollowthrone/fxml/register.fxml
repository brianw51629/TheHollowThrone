<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0"
            style="-fx-background-color: #1a1a2e;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brianwallenrod.thehollowthrone.controllers.RegisterController">
    <children>

        <!-- Title -->
        <Label text="CREATE ACCOUNT"
               alignment="CENTER"
               maxWidth="1.7976931348623157E38"
               style="-fx-text-fill: white; -fx-font-size: 48px; -fx-font-weight: bold;"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0"
               AnchorPane.topAnchor="260.0"/>

        <!-- Card background -->
        <Rectangle arcWidth="20" arcHeight="20"
                   width="400.0" height="380.0"
                   fill="#0d0d1a" stroke="#444466"
                   AnchorPane.leftAnchor="760.0"
                   AnchorPane.topAnchor="350.0"/>

        <!-- Username -->
        <TextField fx:id="usernameField"
                   promptText="USERNAME"
                   prefWidth="300.0" prefHeight="40.0"
                   style="-fx-font-size: 16px;"
                   AnchorPane.leftAnchor="810.0"
                   AnchorPane.topAnchor="390.0"/>

        <!-- Password -->
        <PasswordField fx:id="passwordField"
                       promptText="PASSWORD"
                       prefWidth="300.0" prefHeight="40.0"
                       style="-fx-font-size: 16px;"
                       AnchorPane.leftAnchor="810.0"
                       AnchorPane.topAnchor="450.0"/>

        <!-- Confirm Password -->
        <PasswordField fx:id="confirmPasswordField"
                       promptText="CONFIRM PASSWORD"
                       prefWidth="300.0" prefHeight="40.0"
                       style="-fx-font-size: 16px;"
                       AnchorPane.leftAnchor="810.0"
                       AnchorPane.topAnchor="510.0"/>

        <!-- Register Button -->
        <Button text="Register"
                prefWidth="300.0" prefHeight="45.0"
                style="-fx-font-size: 16px; -fx-font-weight: bold;"
                onAction="#handleRegister"
                AnchorPane.leftAnchor="810.0"
                AnchorPane.topAnchor="575.0"/>

        <!-- Back to Login -->
        <Button text="Back to Login"
                prefWidth="300.0" prefHeight="45.0"
                style="-fx-font-size: 16px;"
                onAction="#handleBack"
                AnchorPane.leftAnchor="810.0"
                AnchorPane.topAnchor="635.0"/>

    </children>
</AnchorPane>
