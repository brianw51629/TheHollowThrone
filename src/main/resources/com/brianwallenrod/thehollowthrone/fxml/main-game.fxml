<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0"
            style="-fx-background-color: #1a1a2e;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brianwallenrod.thehollowthrone.controllers.MainGameController">

    <children>

        <!-- TOP BAR -->
        <Button fx:id="quitButton" text="QUIT"
                prefHeight="36.0" prefWidth="120.0"
                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #2a2a4a; -fx-text-fill: white; -fx-border-color: #444466; -fx-border-width: 1;"
                onAction="#handleQuit"
                AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="10.0"/>

        <Button fx:id="saveButton" text="SAVE"
                prefHeight="36.0" prefWidth="120.0"
                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #2a2a4a; -fx-text-fill: white; -fx-border-color: #444466; -fx-border-width: 1;"
                onAction="#handleSave"
                AnchorPane.leftAnchor="160.0" AnchorPane.topAnchor="10.0"/>

        <Button fx:id="loadButton" text="LOAD"
                prefHeight="36.0" prefWidth="120.0"
                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #2a2a4a; -fx-text-fill: white; -fx-border-color: #444466; -fx-border-width: 1;"
                onAction="#handleLoad"
                AnchorPane.leftAnchor="300.0" AnchorPane.topAnchor="10.0"/>

        <Button fx:id="inventoryButton" text="INVENTORY"
                prefHeight="36.0" prefWidth="120.0"
                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #2a2a4a; -fx-text-fill: white; -fx-border-color: #444466; -fx-border-width: 1;"
                onAction="#handleInventory"
                AnchorPane.leftAnchor="440.0" AnchorPane.topAnchor="10.0"/>

        <!-- Divider under top bar -->
        <Line endX="1920" endY="0" startX="0" startY="0"
              stroke="#444466"
              layoutX="0.0" layoutY="55.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="55.0"/>

        <!-- Divider between left panel and map -->
        <Line endX="0" endY="1080" startX="0" startY="0"
              stroke="#444466"
              layoutX="640.0" layoutY="55.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="640.0" AnchorPane.topAnchor="55.0"/>

        <!-- Character image -->
        <ImageView fx:id="characterView"
                   pickOnBounds="true"
                   preserveRatio="true"
                   smooth="false"
                   fitWidth="620.0"
                   fitHeight="800.0"
                   AnchorPane.topAnchor="65.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="1280.0"
                   AnchorPane.bottomAnchor="220.0"/>

        <!-- Stats box background -->
        <Rectangle fx:id="statsBox"
                   arcHeight="10" arcWidth="10"
                   fill="#0d0d1a" stroke="#444466"
                   height="210.0" width="640.0"
                   AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"/>

        <!-- Stats labels left column -->
        <Label fx:id="nameLabel" text="Name:"
               style="-fx-text-fill: white; -fx-font-size: 15px;"
               AnchorPane.bottomAnchor="160.0" AnchorPane.leftAnchor="20.0"/>
        <Label fx:id="classLabel" text="Class:"
               style="-fx-text-fill: white; -fx-font-size: 15px;"
               AnchorPane.bottomAnchor="130.0" AnchorPane.leftAnchor="20.0"/>
        <Label fx:id="levelLabel" text="Level: 1"
               style="-fx-text-fill: white; -fx-font-size: 15px;"
               AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="20.0"/>
        <Label fx:id="hpLabel" text="HP: 0/0"
               style="-fx-text-fill: #6bff6b; -fx-font-size: 15px;"
               AnchorPane.bottomAnchor="70.0" AnchorPane.leftAnchor="20.0"/>

        <!-- Stats labels right column -->
        <Label fx:id="strLabel" text="STR: 0"
               style="-fx-text-fill: white; -fx-font-size: 15px;"
               AnchorPane.bottomAnchor="160.0" AnchorPane.leftAnchor="340.0"/>
        <Label fx:id="dexLabel" text="DEX: 0"
               style="-fx-text-fill: white; -fx-font-size: 15px;"
               AnchorPane.bottomAnchor="130.0" AnchorPane.leftAnchor="340.0"/>
        <Label fx:id="intLabel" text="INT: 0"
               style="-fx-text-fill: white; -fx-font-size: 15px;"
               AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="340.0"/>
        <Label fx:id="xpLabel" text="XP: 0"
               style="-fx-text-fill: #aaaaff; -fx-font-size: 15px;"
               AnchorPane.bottomAnchor="70.0" AnchorPane.leftAnchor="340.0"/>

        <!-- MAP -->
        <GridPane fx:id="mapGrid"
                  hgap="4.0" vgap="4.0"
                  AnchorPane.topAnchor="65.0"
                  AnchorPane.leftAnchor="650.0"
                  AnchorPane.rightAnchor="10.0"
                  AnchorPane.bottomAnchor="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" vgrow="ALWAYS"/>
                <RowConstraints minHeight="10.0" vgrow="ALWAYS"/>
                <RowConstraints minHeight="10.0" vgrow="ALWAYS"/>
                <RowConstraints minHeight="10.0" vgrow="ALWAYS"/>
                <RowConstraints minHeight="10.0" vgrow="ALWAYS"/>
            </rowConstraints>
        </GridPane>

    </children>
</AnchorPane>
