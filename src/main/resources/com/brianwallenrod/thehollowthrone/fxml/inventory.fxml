<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0"
            style="-fx-background-color: #1a1a2e;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brianwallenrod.thehollowthrone.controllers.InventoryController">
    <children>

        <!-- Title -->
        <Label text="INVENTORY"
               alignment="CENTER"
               maxWidth="1.7976931348623157E38"
               style="-fx-text-fill: white; -fx-font-size: 48px; -fx-font-weight: bold;"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0"
               AnchorPane.topAnchor="30.0"/>

        <!-- Slots label -->
        <Label fx:id="slotsLabel" text="Items: 0/10"
               alignment="CENTER"
               maxWidth="1.7976931348623157E38"
               style="-fx-text-fill: #aaaaff; -fx-font-size: 20px;"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0"
               AnchorPane.topAnchor="95.0"/>

        <!-- Item list background -->
        <Rectangle arcWidth="10" arcHeight="10"
                   fill="#0d0d1a" stroke="#444466"
                   width="700.0"
                   AnchorPane.leftAnchor="610.0"
                   AnchorPane.topAnchor="135.0"
                   AnchorPane.bottomAnchor="290.0"/>

        <!-- Item list -->
        <ListView fx:id="itemListView"
                  prefWidth="680.0"
                  style="-fx-background-color: #0d0d1a; -fx-text-fill: white; -fx-font-size: 16px;"
                  AnchorPane.leftAnchor="620.0"
                  AnchorPane.topAnchor="145.0"
                  AnchorPane.bottomAnchor="300.0"/>

        <!-- Item description background -->
        <Rectangle arcWidth="10" arcHeight="10"
                   fill="#0d0d1a" stroke="#444466"
                   width="700.0" height="100.0"
                   AnchorPane.leftAnchor="610.0"
                   AnchorPane.bottomAnchor="180.0"/>

        <!-- Item description -->
        <Label fx:id="descriptionLabel"
               text="Select an item to see its description."
               alignment="CENTER"
               maxWidth="680.0"
               wrapText="true"
               style="-fx-text-fill: #aaaaff; -fx-font-size: 16px;"
               AnchorPane.leftAnchor="620.0"
               AnchorPane.bottomAnchor="190.0"/>

        <!-- Use Item Button -->
        <Button fx:id="useButton" text="USE ITEM"
                prefWidth="220.0" prefHeight="55.0"
                style="-fx-font-size: 16px; -fx-font-weight: bold;"
                onAction="#handleUseItem"
                AnchorPane.leftAnchor="610.0"
                AnchorPane.bottomAnchor="110.0"/>

        <!-- Drop Item Button -->
        <Button fx:id="dropButton" text="DROP ITEM"
                prefWidth="220.0" prefHeight="55.0"
                style="-fx-font-size: 16px; -fx-font-weight: bold;"
                onAction="#handleDropItem"
                AnchorPane.leftAnchor="850.0"
                AnchorPane.bottomAnchor="110.0"/>

        <!-- Back Button -->
        <Button text="BACK"
                prefWidth="220.0" prefHeight="55.0"
                style="-fx-font-size: 16px; -fx-font-weight: bold;"
                onAction="#handleBack"
                AnchorPane.leftAnchor="730.0"
                AnchorPane.bottomAnchor="40.0"/>

    </children>
</AnchorPane>
