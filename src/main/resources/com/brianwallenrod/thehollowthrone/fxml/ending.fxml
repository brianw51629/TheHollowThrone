<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0"
            style="-fx-background-color: #0a0a00;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brianwallenrod.thehollowthrone.controllers.EndingController">
    <children>

        <!-- Golden top accent line -->
        <Rectangle fill="#ffd700" height="4.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0"
                   AnchorPane.topAnchor="0.0"/>

        <!-- Golden bottom accent line -->
        <Rectangle fill="#ffd700" height="4.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"/>

        <!-- VICTORY title -->
        <Label text="VICTORY"
               alignment="CENTER"
               maxWidth="1.7976931348623157E38"
               style="-fx-text-fill: #ffd700; -fx-font-size: 80px; -fx-font-weight: bold;"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0"
               AnchorPane.topAnchor="60.0"/>

        <!-- Character name and class -->
        <Label fx:id="characterLabel"
               text=""
               alignment="CENTER"
               maxWidth="1.7976931348623157E38"
               style="-fx-text-fill: white; -fx-font-size: 28px;"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0"
               AnchorPane.topAnchor="185.0"/>

        <!-- Divider -->
        <Rectangle fill="#ffd700" height="2.0" width="600.0"
                   AnchorPane.leftAnchor="660.0"
                   AnchorPane.topAnchor="240.0"/>

        <!-- Epilogue text box -->
        <Rectangle arcWidth="10" arcHeight="10"
                   fill="#0d0d00" stroke="#ffd700"
                   width="900.0" height="220.0"
                   AnchorPane.leftAnchor="510.0"
                   AnchorPane.topAnchor="265.0"/>

        <!-- Epilogue text -->
        <Label fx:id="epilogueLabel"
               text=""
               alignment="CENTER"
               wrapText="true"
               maxWidth="860.0"
               style="-fx-text-fill: #ffffcc; -fx-font-size: 18px; -fx-font-style: italic;"
               AnchorPane.leftAnchor="530.0"
               AnchorPane.topAnchor="285.0"/>

        <!-- Divider -->
        <Rectangle fill="#ffd700" height="2.0" width="600.0"
                   AnchorPane.leftAnchor="660.0"
                   AnchorPane.topAnchor="500.0"/>

        <!-- Stats box -->
        <Rectangle arcWidth="10" arcHeight="10"
                   fill="#0d0d00" stroke="#444400"
                   width="500.0" height="260.0"
                   AnchorPane.leftAnchor="710.0"
                   AnchorPane.topAnchor="525.0"/>

        <!-- Stats title -->
        <Label text="FINAL STATS"
               alignment="CENTER"
               maxWidth="500.0"
               style="-fx-text-fill: #ffd700; -fx-font-size: 22px; -fx-font-weight: bold;"
               AnchorPane.leftAnchor="710.0"
               AnchorPane.topAnchor="540.0"/>

        <Label fx:id="statLevelLabel" text=""
               style="-fx-text-fill: white; -fx-font-size: 18px;"
               AnchorPane.leftAnchor="780.0"
               AnchorPane.topAnchor="580.0"/>

        <Label fx:id="statGoldLabel" text=""
               style="-fx-text-fill: #ffd700; -fx-font-size: 18px;"
               AnchorPane.leftAnchor="780.0"
               AnchorPane.topAnchor="615.0"/>

        <Label fx:id="statHpLabel" text=""
               style="-fx-text-fill: #6bff6b; -fx-font-size: 18px;"
               AnchorPane.leftAnchor="780.0"
               AnchorPane.topAnchor="650.0"/>

        <Label fx:id="statStrLabel" text=""
               style="-fx-text-fill: white; -fx-font-size: 18px;"
               AnchorPane.leftAnchor="780.0"
               AnchorPane.topAnchor="685.0"/>

        <Label fx:id="statDexLabel" text=""
               style="-fx-text-fill: white; -fx-font-size: 18px;"
               AnchorPane.leftAnchor="1000.0"
               AnchorPane.topAnchor="685.0"/>

        <Label fx:id="statIntLabel" text=""
               style="-fx-text-fill: white; -fx-font-size: 18px;"
               AnchorPane.leftAnchor="780.0"
               AnchorPane.topAnchor="720.0"/>

        <!-- Buttons -->
        <Button text="PLAY AGAIN"
                prefWidth="220.0" prefHeight="60.0"
                style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-background-color: #ffd700; -fx-text-fill: black;"
                onAction="#handlePlayAgain"
                AnchorPane.leftAnchor="710.0"
                AnchorPane.bottomAnchor="40.0"/>

        <Button text="MAIN MENU"
                prefWidth="220.0" prefHeight="60.0"
                style="-fx-font-size: 18px; -fx-font-weight: bold;"
                onAction="#handleMainMenu"
                AnchorPane.leftAnchor="990.0"
                AnchorPane.bottomAnchor="40.0"/>

    </children>
</AnchorPane>
